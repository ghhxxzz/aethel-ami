# Copie este arquivo para ".env" e preencha. O arquivo ".env" NUNCA vai para o GitHub.
GROQ_API_KEY=cole_sua_chave_aqui

# Modelo de chat (confira os disponíveis com:  npm run models)
GROQ_MODEL=openai/gpt-oss-120b

# Porta do servidor (no Render a porta é definida sozinha)
PORT=8787

# Quem pode chamar o backend, separado por vírgula. O app instalado usa tauri.localhost.
CORS_ORIGINS=http://localhost:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Modelo de voz -> texto (Whisper)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Opcionais
# GROQ_REASONING_EFFORT=medium
# REQUEST_TIMEOUT_MS=120000
